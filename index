<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>STEAM Champions 2026/27</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@400;500;600;700&family=Space+Mono:wght@700&display=swap">
<style>
/* Layout: compact plum header (title + countdown card side by side), ONE sticky bar holding tabs + EN/AR,
   then bright white cards with tangerine / sky / pink accents. One deliberate look in every theme. */
:root{
  color-scheme:light;
  --plum:#2a1846; --plum2:#47267a; --tang:#ff7a2f; --sky:#2fa8e8; --pink:#ff4f8b; --sun:#ffc23d; --mint:#2fbf8f;
  --bg:#f6f4fb; --card:#ffffff; --ink:#1d1530; --mute:#62597a; --line:#e7e2f1; --soft:#f1edf9;
  --f-head:"Readex Pro","Segoe UI",Tahoma,sans-serif;
  --f-body:"Readex Pro","Segoe UI",Tahoma,Arial,sans-serif;
  --f-num:"Space Mono",Consolas,monospace;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.7 var(--f-body)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:20;background:var(--plum)}
#app[data-lang="en"] .ar,#app[data-lang="ar"] .en{display:none!important}
.gut{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.col{max-width:1060px;margin:0 auto}
a{color:var(--plum2);font-weight:600}
:focus-visible{outline:3px solid var(--tang);outline-offset:3px}
h1,h2,h3,h4{font-family:var(--f-head);line-height:1.2;margin:0;text-wrap:balance}

/* ===== COMPACT HEADER ===== */
.hero{background:radial-gradient(500px 240px at 100% 0%,rgba(255,122,47,.35),transparent 60%),radial-gradient(420px 220px at 0% 100%,rgba(47,168,232,.35),transparent 60%),linear-gradient(135deg,var(--plum),var(--plum2));color:#fff;padding-block:22px 24px}
.herogrid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:22px;align-items:center}
@media (max-width:860px){.herogrid{grid-template-columns:1fr;gap:16px}}
.season{display:inline-flex;gap:6px;align-items:center;background:rgba(255,255,255,.12);border-radius:999px;padding:3px 12px;font-weight:600;font-size:13px}
.season i{width:8px;height:8px;border-radius:50%;background:var(--mint);box-shadow:0 0 0 3px rgba(47,191,143,.35)}
.hero h1{font-size:clamp(28px,4.6vw,46px);font-weight:700;margin:8px 0 4px}
.hero h1 .c{color:var(--sun)}
.theme{font:600 clamp(15px,2vw,18px)/1.4 var(--f-head);margin:0 0 10px;opacity:.95}
.theme .sdg{display:inline-block;background:var(--sun);color:var(--plum);border-radius:6px;padding:0 7px;margin-inline-start:6px;font-size:.8em}
.stats{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0;list-style:none}
.stats li{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:10px;padding:3px 10px;font-size:13px;font-weight:600}
.stats b{font-family:var(--f-num);color:var(--sun);margin-inline-end:4px}
.cdcard{background:#fff;color:var(--ink);border-radius:20px;padding:14px;box-shadow:0 14px 34px rgba(0,0,0,.25)}
.cdcard .lbl{font-weight:600;font-size:14px;color:var(--mute);margin-bottom:6px}
.cd{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
.cd .cell{background:var(--soft);border-radius:12px;padding:6px 4px;text-align:center}
.cd b{display:block;font:700 22px/1.1 var(--f-num);color:var(--tang)}
.cd small{font-weight:600;font-size:11px;color:var(--mute)}
.cdcard .cta{margin-top:10px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:11px 18px;font:600 15px var(--f-head);cursor:pointer;text-decoration:none;transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
.btn.lime,.btn.tang{background:var(--tang);color:#fff;box-shadow:0 8px 20px rgba(255,122,47,.3)}
.btn.ghost{background:var(--soft);color:var(--plum2)}
.btn.green{background:var(--plum2);color:#fff}
.btn.line{background:#fff;color:var(--plum2);border:2px solid var(--plum2)}
.btn.sm{padding:7px 12px;font-size:14px;border-radius:10px}
.cta{display:flex;flex-wrap:wrap;gap:8px}
.cdcard .cta .btn{flex:1}

/* ===== ONE STICKY BAR: tabs + language ===== */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:15;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);box-shadow:0 4px 14px rgba(42,24,70,.06)}
.bar .col{display:flex;align-items:center;gap:10px}
.mini{flex:none;font:700 15px var(--f-head);color:var(--plum);display:flex;gap:6px;align-items:center}
@media (max-width:1180px){.mini{display:none}}
.tablist{flex:1;min-width:0;display:flex;gap:4px;overflow-x:auto;padding-block:8px;scrollbar-width:none}
.tablist::-webkit-scrollbar{display:none}
.tablist button{flex:none;border:0;background:transparent;color:var(--mute);font:600 14px var(--f-head);padding:8px 12px;border-radius:10px;cursor:pointer;white-space:nowrap}
.tablist button:hover{background:var(--soft);color:var(--ink)}
.tablist button[aria-selected="true"]{background:var(--plum);color:#fff}
.lang{flex:none;display:flex;background:var(--soft);border-radius:999px;padding:3px;gap:2px}
.lang button{border:0;border-radius:999px;background:none;color:var(--plum);font:700 13px var(--f-body);padding:5px 11px;cursor:pointer}
.lang button[aria-pressed="true"]{background:var(--tang);color:#fff}

/* ===== SECTIONS ===== */
main{padding-block:26px 56px}
[role="tabpanel"]{display:grid;gap:42px}
.h2{display:flex;align-items:center;gap:12px;margin-bottom:8px}
.h2 .ic{flex:none;width:44px;height:44px;border-radius:14px;display:grid;place-items:center;font-size:22px;background:var(--c)}
h2{font-size:clamp(23px,3.4vw,30px);font-weight:700}
.lead{color:var(--mute);margin:0 0 16px;max-width:68ch}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
@media (max-width:820px){.grid3,.grid2{grid-template-columns:1fr}}
.card{background:var(--card);border-radius:18px;border:1px solid var(--line);padding:16px 18px;box-shadow:0 2px 0 var(--line)}
.card h3{font-size:18px;font-weight:700;margin:6px 0 4px}
.card p{margin:0;color:var(--mute)}
.card .emo{font-size:30px;line-height:1}
.ticks{margin:0;padding:0;list-style:none;display:grid;gap:8px}
.ticks li{display:flex;gap:10px;align-items:flex-start}
.ticks li::before{content:"🔸";flex:none}
.ticks.check li::before{content:"✅"}
.ticks.no li::before{content:"⛔"}

.vs{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:12px;align-items:stretch}
@media (max-width:820px){.vs{grid-template-columns:1fr}.vs .arrow{transform:rotate(90deg)}}
.flow{border-radius:18px;padding:16px;color:#fff}
.flow.lin{background:#6b6478}
.flow.cir{background:linear-gradient(135deg,var(--tang),var(--pink))}
.flow h3{font-size:18px;font-weight:700;margin-bottom:8px}
.steps{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px}
.steps span{background:rgba(255,255,255,.22);border-radius:999px;padding:2px 10px;font:600 13px var(--f-head)}
.steps i{font-style:normal;opacity:.8}
.flow p{margin:0}
.vs .arrow{display:grid;place-items:center;font-size:30px}

.cat{border-radius:20px;padding:18px;color:#fff;background:var(--c);display:flex;flex-direction:column;gap:8px}
.cat .n{font:700 34px/1 var(--f-num);opacity:.4}
.cat h3{font-size:20px;font-weight:700}
.cat ul{margin:0;padding:0;list-style:none;display:grid;gap:4px}
.cat li{background:rgba(255,255,255,.17);border-radius:10px;padding:3px 10px;font-size:14px}
.cat .pill{align-self:flex-start;background:#fff;color:var(--ink);border-radius:999px;padding:1px 10px;font-weight:600;font-size:12px}

.world{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
@media (max-width:820px){.world{grid-template-columns:repeat(2,minmax(0,1fr))}}
.flag{background:#fff;border:1px solid var(--line);border-radius:18px;padding:12px;text-align:center}
.flag .f{font-size:34px}
.flag b{display:block;font-family:var(--f-head)}
.flag span{font-size:13px;color:var(--mute)}
.note{margin-top:14px;background:#fff6e6;border:1px solid #ffd79a;border-radius:14px;padding:12px 14px;display:flex;gap:10px}
.note p{margin:0}

.finder{background:linear-gradient(135deg,var(--plum),var(--plum2));color:#fff;border-radius:22px;padding:18px}
.finder .row{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end}
.finder label{display:block;font:600 14px var(--f-head);margin-bottom:6px}
.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg button{border:2px solid rgba(255,255,255,.3);background:transparent;color:#fff;border-radius:12px;padding:6px 16px;font:700 15px var(--f-head);cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--sun);border-color:var(--sun);color:var(--plum)}
.finder select{font:600 15px var(--f-body);border-radius:10px;border:0;padding:8px 12px;background:#fff;color:var(--ink)}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chips button{border:1.5px solid rgba(255,255,255,.3);background:rgba(255,255,255,.08);color:#fff;border-radius:999px;padding:4px 12px;font:600 13px var(--f-body);cursor:pointer}
.chips button[aria-pressed="true"]{background:var(--tang);border-color:var(--tang)}
.result{margin-top:12px;font:600 15px var(--f-head);color:var(--sun)}
.comps{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:14px;margin-top:16px}
.comp{background:#fff;border-radius:18px;border:1px solid var(--line);overflow:hidden;display:flex;flex-direction:column;box-shadow:0 2px 0 var(--line)}
.comp .top{padding:12px 16px;background:var(--c);color:#fff}
.comp .top small{font-weight:600;font-size:11px;opacity:.92;text-transform:uppercase;letter-spacing:.05em}
#app[data-lang="ar"] .comp .top small{letter-spacing:0}
.comp .top h3{font-size:19px;font-weight:700;margin-top:2px}
.comp .meta{display:flex;flex-wrap:wrap;gap:6px;padding:10px 16px 0}
.comp .meta span{background:var(--soft);border-radius:999px;padding:1px 10px;font-weight:600;font-size:13px}
.comp dl{margin:0;padding:10px 16px;display:grid;gap:4px;font-size:15px}
.comp dt{font:600 12px var(--f-head);color:var(--tang);text-transform:uppercase;letter-spacing:.04em;margin-top:4px}
#app[data-lang="ar"] .comp dt{letter-spacing:0}
.comp dd{margin:0}
.comp .links{margin-top:auto;padding:0 16px 16px;display:flex;flex-wrap:wrap;gap:6px}
.comp.dim{opacity:.5;filter:grayscale(.6)}
details.more{margin-top:16px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:6px 16px}
details.more summary{cursor:pointer;font:600 15px var(--f-head);padding:8px 0}

.journey{list-style:none;margin:0;padding:0;display:grid;gap:10px;counter-reset:j}
.journey li{counter-increment:j;display:grid;grid-template-columns:46px minmax(0,1fr);gap:14px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px 14px}
.journey li::before{content:counter(j);width:46px;height:46px;border-radius:14px;background:var(--c,var(--plum2));color:#fff;display:grid;place-items:center;font:700 20px var(--f-head)}
.journey h3{font-size:17px;font-weight:700;margin-bottom:2px}
.journey p{margin:0;color:var(--mute)}
.timeline{background:#fff;border:1px solid var(--line);border-radius:18px;padding:18px}
.tl{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
@media (max-width:820px){.tl{grid-template-columns:1fr}}
.tl .pt{border-top:6px solid var(--line);padding-top:8px}
.tl .pt.done{border-color:var(--mint)}
.tl .pt.next{border-color:var(--tang)}
.tl time{font:700 14px var(--f-num);color:var(--plum);direction:ltr;unicode-bidi:isolate;display:inline-block}
.tl .pt.next time{color:var(--tang)}
.tl b{display:block;font-family:var(--f-head);font-weight:600}
.tl span{font-size:14px;color:var(--mute)}
.today{margin-top:10px;font-weight:600;color:var(--tang)}
.zones{display:flex;flex-wrap:wrap;gap:8px}
.src{margin:8px 0 0;font-size:12.5px;line-height:1.6;color:var(--mute)}
.src a{color:var(--plum2);font-weight:600;text-decoration:underline;text-decoration-color:rgba(71,38,122,.3);text-underline-offset:2px}
.src a:hover{color:var(--tang)}
.rdocs{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.rdocs li{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:10px 14px}
.rd-n{font-weight:700}
.rdocs li > a:first-of-type{margin-inline-start:auto}
.rd-s{display:inline-flex;align-items:center;gap:4px;border-radius:999px;padding:4px 12px;font-size:13.5px;text-decoration:none;white-space:nowrap}
.rd-s + .rd-s{margin-inline-start:0}
.rd-s.ok{background:var(--plum2);color:#fff}
.rd-s.ok:hover{background:var(--tang)}
.rd-s.wait{background:#fff6e6;color:#a8470f;border:1px solid #ffd79a}
.zones span{background:#fff;border:1px solid var(--line);border-radius:999px;padding:4px 12px;font-weight:600;font-size:14px}

.faq{display:grid;gap:8px}
.faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:2px 16px}
.faq details[open]{border-color:var(--tang)}
.faq summary{cursor:pointer;list-style:none;display:flex;gap:12px;align-items:center;padding:11px 0;font:600 16px var(--f-head)}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";margin-inline-start:auto;font-size:22px;color:var(--tang)}
.faq details[open] summary::after{content:"–"}
.faq p{margin:0 0 12px;color:var(--mute);padding-inline-start:32px}

.formcard{background:#fff;border:1px solid var(--line);border-radius:22px;padding:20px}
form{display:grid;gap:16px}
.frow{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))}
.frow>*{min-width:0}
.formcard label,.formcard .lbl{display:block;font:600 15px var(--f-head);margin-bottom:6px}
.hint{font:400 13px var(--f-body);color:var(--mute)}
input[type=text],select,textarea{width:100%;font:15px var(--f-body);color:var(--ink);background:var(--soft);border:1.5px solid var(--line);border-radius:12px;padding:10px 12px}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--plum2);box-shadow:0 0 0 4px rgba(71,38,122,.12)}
textarea{min-height:80px;resize:vertical}
.pick{display:flex;flex-wrap:wrap;gap:8px}
.pick label{display:inline-flex !important;align-items:center;gap:6px;margin:0 !important;font:600 14px var(--f-body) !important;border:1.5px solid var(--line);border-radius:999px;padding:6px 13px;cursor:pointer;background:#fff}
.pick input{position:absolute;opacity:0;pointer-events:none}
.pick label:has(input:checked){background:var(--plum2);border-color:var(--plum2);color:#fff}
.pick label:has(input:focus-visible){outline:3px solid var(--tang)}
.checkline{display:flex;gap:10px;align-items:flex-start;font-weight:600}
.checkline input{width:20px;height:20px;margin-top:4px;flex:none;accent-color:var(--plum2)}
.err{color:var(--pink);font-weight:600;min-height:1em}
.out{margin-top:18px;display:grid;gap:10px;background:#fff6ef;border:1.5px solid var(--tang);border-radius:18px;padding:16px}
#msg{min-height:250px;font:14px/1.6 var(--f-body)}
.status{color:var(--mint);font-weight:600;min-height:1.3em}
.mail{font:700 13px var(--f-num);background:var(--soft);padding:2px 8px;border-radius:8px;user-select:all;word-break:break-all;color:var(--ink)}
.small{font-size:14px;color:var(--mute);margin:0}

footer{background:var(--plum);color:#e4dcf3;padding-block:30px 36px}
footer .fg{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
@media (max-width:820px){footer .fg{grid-template-columns:1fr}}
footer h4{font:700 16px var(--f-head);color:var(--sun);margin-bottom:8px}
footer ul{list-style:none;margin:0;padding:0;display:grid;gap:4px;font-size:14px}
footer a{color:#fff}
footer .mail{background:rgba(255,255,255,.1);color:#fff}
footer .made{margin-top:22px;padding-top:12px;border-top:1px solid rgba(255,255,255,.15);font-size:13px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
@media (prefers-reduced-motion:reduce){.btn{transition:none}.btn:hover{transform:none}}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
</style>
<style>[hidden]{display:none!important}img{max-width:100%}</style>
</head>
<body>


<div id="app" data-lang="en" dir="ltr" lang="en">

<!-- ================= COMPACT HEADER ================= -->
<header class="hero gut"><div class="col herogrid">
  <div style="min-width:0">
    <div class="season"><i></i><span class="en">2026/2027 · Fourth season · Registration open</span><span class="ar">2026/2027 · الموسم الرابع · التسجيل مفتوح</span></div>
    <h1><span class="en">🏆 STEAM <span class="c">Champions</span> UAE</span><span class="ar">🏆 أبطال <span class="c">STEAM</span> الإمارات</span></h1>
    <p class="theme"><span class="en">♻️ Circular Futures: Reimagining Resources for a Sustainable Tomorrow</span><span class="ar">♻️ مستقبل دائري: إعادة تصور الموارد من أجل غدٍ مستدام</span><span class="sdg">SDG 12</span></p>
    <ul class="stats">
      <li><b>3</b><span class="en">categories</span><span class="ar">فئات</span></li>
      <li><b>12</b><span class="en">competitions</span><span class="ar">مسابقة</span></li>
      <li><b>KG–12</b><span class="en">ages 4–18</span><span class="ar">أعمار 4–18</span></li>
      <li>🏟️ <span class="en">Final: Dubai, 20 Mar 2027</span><span class="ar">النهائي: دبي، 20 مارس 2027</span></li>
    </ul>
  </div>
  <div class="cdcard">
    <div class="lbl">⏳ <span class="en">Registration closes in (31 Oct 2026)</span><span class="ar">يُغلق التسجيل بعد (31 أكتوبر 2026)</span></div>
    <div class="cd" id="cd">
      <div class="cell"><b id="d">--</b><small class="en">days</small><small class="ar">يوم</small></div>
      <div class="cell"><b id="h">--</b><small class="en">hours</small><small class="ar">ساعة</small></div>
      <div class="cell"><b id="m">--</b><small class="en">min</small><small class="ar">دقيقة</small></div>
      <div class="cell"><b id="s">--</b><small class="en">sec</small><small class="ar">ثانية</small></div>
    </div>
    <div class="cta">
      <a class="btn tang" href="#finder" data-go="finder">🎯 <span class="en">Find my competition</span><span class="ar">اعثر على مسابقتي</span></a>
      <a class="btn ghost" href="#join" data-go="join">🚀 <span class="en">Join</span><span class="ar">انضم</span></a>
    </div>
  </div>
</div></header>

<!-- ================= STICKY BAR: TABS + LANGUAGE ================= -->
<nav class="bar gut" aria-label="Sections"><div class="col">
  <div class="mini">🏆 STEAM Champions</div>
  <div class="tablist" role="tablist">
    <button role="tab" id="t-about" aria-controls="about" aria-selected="true">🌍 <span class="en">About</span><span class="ar">عن المسابقة</span></button>
    <button role="tab" id="t-finder" aria-controls="finder" aria-selected="false" tabindex="-1">🎯 <span class="en">Find my competition</span><span class="ar">اعثر على مسابقتي</span></button>
    <button role="tab" id="t-journey" aria-controls="journey" aria-selected="false" tabindex="-1">🗓️ <span class="en">Journey &amp; dates</span><span class="ar">الرحلة والمواعيد</span></button>
    <button role="tab" id="t-faq" aria-controls="faq" aria-selected="false" tabindex="-1">❓ <span class="en">Rules &amp; FAQ</span><span class="ar">القواعد والأسئلة</span></button>
    <button role="tab" id="t-join" aria-controls="join" aria-selected="false" tabindex="-1">🚀 <span class="en">Join</span><span class="ar">انضم</span></button>
    <button role="tab" id="t-parents" aria-controls="parents" aria-selected="false" tabindex="-1">👨‍👩‍👧 <span class="en">Parents &amp; teachers</span><span class="ar">أولياء الأمور والمعلمون</span></button>
